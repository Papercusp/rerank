{
  "name": "@papercusp/rerank",
  "version": "0.1.0",
  "description": "Engine-agnostic cross-encoder reranking: a local ONNX cross-encoder (no key, no network) or the hosted ZeroEntropy zerank API. Shared across Papercusp and Restart.",
  "license": "UNLICENSED",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zeroentropy": "^0.1.0-alpha.10"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=4"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
